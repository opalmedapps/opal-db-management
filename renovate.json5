{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':separateMultipleMajorReleases',
    ':separatePatchReleases',
    ':enablePreCommit',
    'github>mschoettle/renovate-presets//presets/docker-alpine.json5',
    'github>mschoettle/renovate-presets//presets/actions-dependency-version.json5',
  ],
  pip_requirements: {
    managerFilePatterns: [
      '/^requirements/.*\\.txt$/',
    ],
  },
  assignees: [
    'mschoettle',
  ],
  labels: [
    'dependencies',
  ],
  rebaseWhen: 'conflicted',
  'pre-commit': {
    enabled: true,
  },
  packageRules: [
    {
      matchDatasources: [
        'docker',
        'docker-compose',
      ],
      semanticCommitType: 'build',
    },
    {
      groupName: 'mypy type stubs',
      matchPackageNames: [
        '/-stubs$/',
        '/^types-/',
      ],
    },
    {
      separateMinorPatch: true,
      matchPackageNames: [
        '/python/',
        '/mariadb/',
      ],
    },
    {
      groupName: 'ruff',
      matchPackageNames: [
        '/ruff-pre-commit|ruff$/',
      ],
    },
    {
      groupName: 'uv',
      matchPackageNames: [
        '/uv-pre-commit|uv$/',
      ],
    },
  ],
}
